# Telegram Control Panel

# ============================================================
# TELEGRAM API CREDENTIALS
# Get from: https://my.telegram.org/apps
# ============================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=YOUR_API_HASH_HERE
TELEGRAM_PHONE=+XXXXXXXXXXXX

TELEGRAM_SESSION_NAME=telegramcontrolpanel

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL="file:./data/telegramcontrolpanel.db"

# ============================================================
# WEB SERVER
# ============================================================
# 127.0.0.1 = only reachable via nginx (recommended). 0.0.0.0 = open on the server IP.
WEB_HOST=127.0.0.1
WEB_PORT=4567

# ============================================================
# ADMIN CREDENTIALS
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# ============================================================
# SESSION COOKIE SECRET (generate with: openssl rand -hex 32)
# ============================================================
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Set to true ONLY when the panel is served over HTTPS
COOKIE_SECURE=false

# ============================================================
# BACKGROUND JOBS
# Exactly one process must run jobs:
#  - production / PM2: keep false and run the tcp-worker app (npm run worker)
#  - simple setups / npm run dev: set true and do NOT start a separate worker
# ============================================================
EMBEDDED_WORKER=false
WORKER_CONCURRENCY=3

# ============================================================
# LOCATION
# ============================================================
LOCATION_RETENTION_DAYS=7
